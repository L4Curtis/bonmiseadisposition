generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppConfig {
  id          String    @id @default(uuid())
  category    String
  key         String
  value       String?
  encrypted   Boolean   @default(false)
  description String?
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedById String?   @map("updated_by_id")
  updatedBy   User?     @relation(fields: [updatedById], references: [id])

  @@unique([category, key])
  @@map("app_config")
}

model Filiale {
  id          String   @id @default(uuid())
  name        String
  displayName String   @map("display_name")
  logoPath    String?  @map("logo_path")
  stampPath   String?  @map("stamp_path")
  address     String?
  siret       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]
  bons  Bon[]

  @@map("filiales")
}

enum UserRole {
  admin
  technician
  collaborator
}

model User {
  id              String    @id @default(uuid())
  samAccountName  String    @unique @map("sam_account_name")
  displayName     String    @map("display_name")
  email           String    @unique
  department      String?
  company         String?
  title           String?
  filialeId       String?   @map("filiale_id")
  filiale         Filiale?  @relation(fields: [filialeId], references: [id])
  isItStaff       Boolean   @default(false) @map("is_it_staff")
  role            UserRole  @default(collaborator)
  lastLdapSync    DateTime? @map("last_ldap_sync")
  active          Boolean   @default(true)
  passwordHash    String?   @map("password_hash")
  isLocalAccount      Boolean   @default(false) @map("is_local_account")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  passwordChangedAt   DateTime? @map("password_changed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  bonsCreated           Bon[]          @relation("BonCreatedBy")
  bonsCollaborateur     Bon[]          @relation("BonCollaborateur")
  contestations         Contestation[] @relation("ContestationUser")
  contestationsResolved Contestation[] @relation("ContestationResolvedBy")
  signaturesInitiated   Signature[]    @relation("SignatureInitiatedBy")
  configUpdates         AppConfig[]
  auditLogs             AuditLog[]

  @@map("users")
}

enum EquipmentCategory {
  pc_portable
  pc_fixe
  ecran
  souris
  clavier
  casque
  telephone
  housse
  dock
  cable
  autre
}

model EquipmentCatalog {
  id          String            @id @default(uuid())
  category    EquipmentCategory
  brand       String
  model       String
  description String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  packItems     EquipmentPackItem[]
  bonEquipments BonEquipment[]

  @@map("equipment_catalog")
}

model EquipmentPack {
  id          String   @id @default(uuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items EquipmentPackItem[]

  @@map("equipment_packs")
}

model EquipmentPackItem {
  id            String           @id @default(uuid())
  packId        String           @map("pack_id")
  pack          EquipmentPack    @relation(fields: [packId], references: [id], onDelete: Cascade)
  catalogItemId String           @map("catalog_item_id")
  catalogItem   EquipmentCatalog @relation(fields: [catalogItemId], references: [id])
  quantity      Int              @default(1)
  order         Int              @default(0)

  @@map("equipment_pack_items")
}

enum BonStatus {
  draft
  sent_mise_dispo
  active
  sent_restitution
  partially_returned
  archived
  cancelled
  contested
}

enum Civilite {
  mme
  mr
}

model Bon {
  id                  String    @id @default(uuid())
  reference           String    @unique
  filialeId           String    @map("filiale_id")
  filiale             Filiale   @relation(fields: [filialeId], references: [id])
  collaborateurId     String    @map("collaborateur_id")
  collaborateur       User      @relation("BonCollaborateur", fields: [collaborateurId], references: [id])
  collaborateurEmail  String    @map("collaborateur_email")
  createdById         String    @map("created_by_id")
  createdBy           User      @relation("BonCreatedBy", fields: [createdById], references: [id])
  civilite            Civilite
  status              BonStatus @default(draft)
  dateMiseDisposition DateTime  @map("date_mise_disposition") @db.Date
  dateRestitution     DateTime? @map("date_restitution") @db.Date
  notes               String?
  pdfMiseDispoSnapshot     Bytes?    @map("pdf_mise_dispo_snapshot")
  pdfMiseDispoSnapshotAt   DateTime? @map("pdf_mise_dispo_snapshot_at")
  pdfRestitutionSnapshot   Bytes?    @map("pdf_restitution_snapshot")
  pdfRestitutionSnapshotAt DateTime? @map("pdf_restitution_snapshot_at")
  // RGPD : horodatage de l'anonymisation (PII purgées, preuves détruites) une
  // fois la durée de rétention dépassée. Null = bon actif / non anonymisé.
  anonymizedAt             DateTime? @map("anonymized_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  equipments    BonEquipment[]
  signatures    Signature[]
  contestations Contestation[]
  notifications NotificationLog[]
  auditLogs     AuditLog[]
  pdfSnapshots  PdfSnapshot[]
  proofArchives ProofArchive[]
  attachments   Attachment[]
  smbExports    SmbExport[]

  @@index([status])
  @@index([collaborateurId])
  @@index([filialeId])
  @@map("bons")
}

model BonEquipment {
  id              String            @id @default(uuid())
  bonId           String            @map("bon_id")
  bon             Bon               @relation(fields: [bonId], references: [id], onDelete: Cascade)
  catalogItemId   String?           @map("catalog_item_id")
  catalogItem     EquipmentCatalog? @relation(fields: [catalogItemId], references: [id])
  customLabel     String?           @map("custom_label")
  serialNumber    String?           @map("serial_number")
  inventoryNumber String?           @map("inventory_number")
  notes           String?
  order           Int               @default(0)
  returnedAt        DateTime? @map("returned_at")
  notReturned       Boolean   @default(false) @map("not_returned")
  notReturnedReason String?   @map("not_returned_reason")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@map("bon_equipments")
}

enum SignatureType {
  mise_disposition
  restitution
  it_cachet
  pv_cloture
}

enum PdfSnapshotType {
  signature_it_mise_disposition
  signature_collab_mise_disposition
  signature_it_restitution
  signature_collab_restitution
  cloture_equipements_manquants
  avenant_equipement_retrouve
}

model Signature {
  id                 String        @id @default(uuid())
  bonId              String        @map("bon_id")
  bon                Bon           @relation(fields: [bonId], references: [id], onDelete: Cascade)
  type               SignatureType
  token              String        @unique
  tokenExpiresAt     DateTime      @map("token_expires_at")
  signed             Boolean       @default(false)
  signatureImagePath String?       @map("signature_image_path")
  signedAt           DateTime?     @map("signed_at")
  signerEmail        String?       @map("signer_email")
  signerIp           String?       @map("signer_ip")
  signerUserAgent    String?       @map("signer_user_agent")
  mentionLuApprouve  Boolean       @default(false) @map("mention_lu_approuve")
  isInPerson         Boolean       @default(false) @map("is_in_person")
  // Présentiel : signerEmail est le compte (technicien) ayant recueilli la
  // signature pour le compte du collaborateur titulaire → tracé comme mandataire
  signedByProxy      Boolean       @default(false) @map("signed_by_proxy")
  // Scellement probant : HMAC-SHA256 (clé serveur dérivée d'ENCRYPTION_KEY)
  // couvrant les champs probants de la signature → détecte toute altération
  // directe en base (email, horodatage…). sealedAt = moment du scellement.
  seal               String?       @map("seal")
  sealedAt           DateTime?     @map("sealed_at")
  // Horodatage RFC 3161 OPTIONNEL (config 'timestamp') : jeton signé d'une
  // autorité de temps de confiance sur le sceau. Absent si non configuré.
  tsToken            String?       @map("ts_token")
  tsAuthority        String?       @map("ts_authority")
  tsAt               DateTime?     @map("ts_at")
  initiatedById      String?       @map("initiated_by_id")
  initiatedBy        User?         @relation("SignatureInitiatedBy", fields: [initiatedById], references: [id])
  createdAt          DateTime      @default(now()) @map("created_at")

  @@index([bonId, type, signed])
  @@map("signatures")
}

// Pièces jointes d'un bon (photos d'état du matériel, justificatifs). Le binaire
// est chiffré sur disque (AES-256-GCM, comme les signatures) ; seules les
// métadonnées + le SHA-256 d'intégrité sont en base.
model Attachment {
  id              String   @id @default(uuid())
  bonId           String   @map("bon_id")
  bon             Bon      @relation(fields: [bonId], references: [id], onDelete: Cascade)
  // Contexte métier : mise_disposition | restitution | pv_cloture | general
  stage           String
  filename        String
  storedPath      String   @map("stored_path")
  mimeType        String   @map("mime_type")
  size            Int
  sha256          String
  label           String?
  uploadedById    String?  @map("uploaded_by_id")
  uploadedByEmail String?  @map("uploaded_by_email")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([bonId, createdAt])
  @@map("attachments")
}

// Archive probante APPEND-ONLY : une ligne par document de preuve généré,
// jamais écrasée (contrairement à PdfSnapshot qui ne conserve que le « courant »
// par type pour l'affichage). Garantit qu'aucune preuve co-signée — ex. une 1re
// restitution partielle — ne peut disparaître.
model ProofArchive {
  id        String   @id @default(uuid())
  bonId     String   @map("bon_id")
  bon       Bon      @relation(fields: [bonId], references: [id], onDelete: Cascade)
  type      String
  filename  String
  data      Bytes
  sha256    String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([bonId, createdAt])
  @@map("proof_archives")
}

model PdfSnapshot {
  id        String          @id @default(uuid())
  bonId     String          @map("bon_id")
  bon       Bon             @relation(fields: [bonId], references: [id], onDelete: Cascade)
  type      PdfSnapshotType
  data      Bytes
  filename  String
  // SHA-256 hex du document — chaîne de preuve (intégrité vérifiable a posteriori)
  sha256    String?
  createdAt DateTime        @default(now()) @map("created_at")

  @@unique([bonId, type])
  @@map("pdf_snapshots")
}

enum SmbExportStatus {
  pending
  success
  failed
}

model SmbExport {
  id            String          @id @default(uuid())
  bonId         String          @map("bon_id")
  bon           Bon             @relation(fields: [bonId], references: [id], onDelete: Cascade)
  filename      String
  status        SmbExportStatus @default(pending)
  errorMessage  String?         @map("error_message")
  retryCount    Int             @default(0) @map("retry_count")
  lastAttemptAt DateTime?       @map("last_attempt_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([status])
  @@index([bonId])
  @@map("smb_exports")
}

enum ContestationStatus {
  open
  in_review
  resolved
  rejected
}

model Contestation {
  id                String             @id @default(uuid())
  bonId             String             @map("bon_id")
  bon               Bon                @relation(fields: [bonId], references: [id])
  userId            String             @map("user_id")
  user              User               @relation("ContestationUser", fields: [userId], references: [id])
  message           String
  status            ContestationStatus @default(open)
  resolvedById      String?            @map("resolved_by_id")
  resolvedBy        User?              @relation("ContestationResolvedBy", fields: [resolvedById], references: [id])
  resolutionMessage String?            @map("resolution_message")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@map("contestations")
}

enum NotificationType {
  mise_dispo_request
  restitution_request
  pv_cloture_request
  reminder
  confirmation
  contestation_alert
  contestation_resolution
  cancellation
  mark_found
  unilateral_closure
}

enum NotificationStatus {
  sent
  failed
  bounced
}

model NotificationLog {
  id             String             @id @default(uuid())
  bonId          String             @map("bon_id")
  bon            Bon                @relation(fields: [bonId], references: [id])
  recipientEmail String             @map("recipient_email")
  type           NotificationType
  sentAt         DateTime           @default(now()) @map("sent_at")
  status         NotificationStatus
  errorMessage   String?            @map("error_message")
  reminderNumber Int?               @map("reminder_number")

  @@index([bonId, type])
  @@map("notification_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  bonId     String?  @map("bon_id")
  bon       Bon?     @relation(fields: [bonId], references: [id])
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  userEmail String?  @map("user_email")
  action    String
  details   Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([bonId, createdAt])
  @@index([userEmail, action, createdAt])
  @@map("audit_logs")
}

// Persistent revocation list for refresh tokens: survives restarts so that
// logout and rotation-replay detection remain effective across redeploys.
model RevokedToken {
  tokenHash String   @id @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("revoked_tokens")
}
