generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppConfig {
  id          String   @id @default(uuid())
  category    String
  key         String
  value       String?
  encrypted   Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")
  updatedBy   User?    @relation(fields: [updatedById], references: [id])

  @@unique([category, key])
  @@map("app_config")
}

model Filiale {
  id          String   @id @default(uuid())
  // Unicité insensible à la casse assurée par un index fonctionnel en base
  // (migration 20260916100400_unique_constraints : UNIQUE INDEX sur
  // lower(name)), non représentable ici — Prisma ne sait pas déclarer
  // d'index sur une expression sans les previewFeatures extendedIndexes.
  // Le matching LDAP compare les noms en insensible à la casse : une
  // contrainte @unique classique (sensible à la casse) sur ce champ
  // n'empêcherait pas deux filiales "Nord"/"nord" de collisionner côté LDAP.
  name        String
  displayName String   @map("display_name")
  logoPath    String?  @map("logo_path")
  stampPath   String?  @map("stamp_path")
  address     String?
  siret       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]
  bons  Bon[]

  @@map("filiales")
}

enum UserRole {
  admin
  technician
  // Lecture seule : tableau de bord KPI, inventaire, exports CSV — jamais
  // IT staff (isItStaff toujours false), aucun accès aux bons/admin/utilisateurs.
  direction
  collaborator
}

model User {
  id                 String    @id @default(uuid())
  samAccountName     String    @unique @map("sam_account_name")
  displayName        String    @map("display_name")
  // Optionnel : les compagnons de chantier créés manuellement (voir
  // isManualAccount ci-dessous) n'ont pas d'adresse email professionnelle.
  // @unique ci-dessous reste sensible à la casse (comportement Prisma par
  // défaut) ; l'unicité réellement appliquée est insensible à la casse via
  // l'index fonctionnel users_email_lower_idx (migration
  // 20260916100100_normalize_emails : UNIQUE INDEX sur lower(email)), non
  // représentable dans ce schéma sans les previewFeatures extendedIndexes.
  // PostgreSQL autorise plusieurs NULL dans un index unique (classique ou
  // fonctionnel) : plusieurs comptes manuels sans email peuvent coexister,
  // seule une VALEUR d'email dupliquée (insensible à la casse) est rejetée.
  email              String?   @unique
  department         String?
  company            String?
  title              String?
  filialeId          String?   @map("filiale_id")
  filiale            Filiale?  @relation(fields: [filialeId], references: [id])
  isItStaff          Boolean   @default(false) @map("is_it_staff")
  role               UserRole  @default(collaborator)
  lastLdapSync       DateTime? @map("last_ldap_sync")
  active             Boolean   @default(true)
  passwordHash       String?   @map("password_hash")
  isLocalAccount     Boolean   @default(false) @map("is_local_account")
  // Compte créé à la main depuis l'annuaire (POST /users/manual) pour les
  // personnes sans compte Active Directory (compagnons de chantier) : ni AD,
  // ni compte local authentifiable (passwordHash toujours null, isLocalAccount
  // toujours false). Exclu de la synchronisation LDAP (jamais désactivé,
  // modifié ni compté comme absent) et ne peut jamais se connecter (ni SSO —
  // pas d'email forcément —, ni login local — pas d'empreinte de mot de
  // passe).
  isManualAccount    Boolean   @default(false) @map("is_manual_account")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  // Civilité retenue pour ce collaborateur (décision du 25/09, R-002) : vide
  // tant qu'aucun technicien ne l'a choisie, jamais de valeur par défaut. Le
  // formulaire de bon exige un choix explicite, puis la mémorise ici pour la
  // proposer au bon suivant. Pas de reprise depuis les bons existants : leur
  // civilité a longtemps été « M. » par défaut, elle n'est donc pas fiable.
  civilite           Civilite?
  passwordChangedAt  DateTime? @map("password_changed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  bonsCreated           Bon[]          @relation("BonCreatedBy")
  bonsCollaborateur     Bon[]          @relation("BonCollaborateur")
  contestations         Contestation[] @relation("ContestationUser")
  contestationsResolved Contestation[] @relation("ContestationResolvedBy")
  contestationsReviewed Contestation[] @relation("ContestationReviewedBy")
  signaturesInitiated   Signature[]    @relation("SignatureInitiatedBy")
  configUpdates         AppConfig[]
  auditLogs             AuditLog[]

  @@index([filialeId])
  @@map("users")
}

enum EquipmentCategory {
  pc_portable
  pc_fixe
  ecran
  souris
  clavier
  casque
  telephone
  housse
  dock
  cable
  autre
}

model EquipmentCatalog {
  id          String            @id @default(uuid())
  category    EquipmentCategory
  brand       String
  model       String
  description String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  packItems     EquipmentPackItem[]
  bonEquipments BonEquipment[]

  // L'unicité réelle est assurée en base par un index unique fonctionnel,
  // insensible à la casse et partiel (category, lower(brand), lower(model))
  // WHERE active — créé par la migration
  // 20260918120000_catalog_normalize_ci_unique_and_restrict_fk. Le DSL Prisma
  // ne sait pas exprimer d'expression (lower(...)) ni de clause WHERE dans
  // @@unique/@@index : cette contrainte n'apparaît donc QUE dans les
  // migrations, jamais ici. Ne pas rajouter `@@unique([category, brand,
  // model])` — ce serait une unicité sensible à la casse, redondante et
  // incohérente avec l'index réel.
  @@map("equipment_catalog")
}

model EquipmentPack {
  id          String   @id @default(uuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items EquipmentPackItem[]

  @@map("equipment_packs")
}

model EquipmentPackItem {
  id            String           @id @default(uuid())
  packId        String           @map("pack_id")
  pack          EquipmentPack    @relation(fields: [packId], references: [id], onDelete: Cascade)
  catalogItemId String           @map("catalog_item_id")
  catalogItem   EquipmentCatalog @relation(fields: [catalogItemId], references: [id])
  quantity      Int              @default(1)
  order         Int              @default(0)

  @@index([packId])
  @@map("equipment_pack_items")
}

enum BonStatus {
  draft
  sent_mise_dispo
  active
  sent_restitution
  partially_returned
  archived
  cancelled
  contested
}

enum Civilite {
  mme
  mr
}

model Bon {
  id                             String    @id @default(uuid())
  reference                      String    @unique
  filialeId                      String    @map("filiale_id")
  filiale                        Filiale   @relation(fields: [filialeId], references: [id])
  collaborateurId                String    @map("collaborateur_id")
  collaborateur                  User      @relation("BonCollaborateur", fields: [collaborateurId], references: [id])
  // Optionnel : un bon peut être établi au nom d'un collaborateur sans adresse
  // email (compagnon de chantier créé manuellement, cf. User.isManualAccount).
  // Un bon sans adresse ne peut être ni envoyé ni relancé par email — seule la
  // signature présentielle reste possible (voir common/email.ts).
  collaborateurEmail             String?   @map("collaborateur_email")
  createdById                    String    @map("created_by_id")
  createdBy                      User      @relation("BonCreatedBy", fields: [createdById], references: [id])
  civilite                       Civilite
  status                         BonStatus @default(draft)
  dateMiseDisposition            DateTime  @map("date_mise_disposition") @db.Date
  dateRestitution                DateTime? @map("date_restitution") @db.Date
  // « Remarques sur le bon » : visibles par le collaborateur et imprimées
  // sur le PDF.
  notes                          String?
  // « Note interne IT » (décision du 25/09, R-170) : jamais montrée au
  // collaborateur, ni sur le PDF, ni dans un email, ni dans le portail.
  internalNote                   String?   @map("internal_note")
  pdfMiseDispoSnapshot           Bytes?    @map("pdf_mise_dispo_snapshot")
  pdfMiseDispoSnapshotAt         DateTime? @map("pdf_mise_dispo_snapshot_at")
  pdfRestitutionSnapshot         Bytes?    @map("pdf_restitution_snapshot")
  pdfRestitutionSnapshotAt       DateTime? @map("pdf_restitution_snapshot_at")
  // RGPD : horodatage de l'anonymisation (PII purgées, preuves détruites) une
  // fois la durée de rétention dépassée. Null = bon actif / non anonymisé.
  anonymizedAt                   DateTime? @map("anonymized_at")
  // Horodatage d'archivage (bascule vers le statut archived). Null tant que
  // le bon n'a jamais été archivé.
  archivedAt                     DateTime? @map("archived_at")
  // Début de l'attente de signature du document courant (remise, restitution,
  // PV de non-restitution) : posé à chaque NOUVELLE demande (envoi, lancement
  // d'une restitution, émission d'un PV, modification d'un bon envoyé), pas
  // au simple renvoi du même lien ; remis à null quand plus rien n'attend la
  // signature du collaborateur. Sert au retard « Signature en retard » et au
  // compte des rappels, à la place d'updatedAt (horodatage technique).
  awaitingSince                  DateTime? @map("awaiting_since")
  // Annulation d'un bon envoyé : motif obligatoire (décision du 24/09).
  cancelledAt                    DateTime? @map("cancelled_at")
  cancellationReason             String?   @map("cancellation_reason")
  // Les deux gestes « sans signature », distincts (R-014) : motif de chacun.
  // « Constater la remise sans signature » : Remise à signer → En cours.
  handoverWithoutSignatureReason String?   @map("handover_without_signature_reason")
  // « Clôturer sans signature » : → Clôturé (la date est archivedAt).
  closedWithoutSignatureReason   String?   @map("closed_without_signature_reason")
  // Contestation « Fondée » (R-050) : le nouveau bon pointe vers celui qu'il
  // remplace. L'original reste « En cours » jusqu'à la signature du nouveau,
  // puis passe « Clôturé » ; `replacedBy` non nul dit alors « remplacé ».
  replacesBonId                  String?   @unique @map("replaces_bon_id")
  replacesBon                    Bon?      @relation("BonReplacement", fields: [replacesBonId], references: [id])
  replacedBy                     Bon?      @relation("BonReplacement")
  createdAt                      DateTime  @default(now()) @map("created_at")
  updatedAt                      DateTime  @updatedAt @map("updated_at")

  equipments    BonEquipment[]
  signatures    Signature[]
  contestations Contestation[]
  notifications NotificationLog[]
  auditLogs     AuditLog[]
  pdfSnapshots  PdfSnapshot[]
  proofArchives ProofArchive[]
  attachments   Attachment[]
  smbExports    SmbExport[]

  @@index([status])
  @@index([collaborateurId])
  @@index([filialeId])
  @@index([createdAt])
  @@index([status, updatedAt])
  // Signatures en retard et rappels : bons « à signer » par ancienneté de la
  // demande.
  @@index([status, awaitingSince])
  // KPI (tableau de bord) : archivage sur une période, retards de restitution.
  @@index([archivedAt])
  @@index([dateRestitution])
  @@map("bons")
}

model BonEquipment {
  id                String            @id @default(uuid())
  bonId             String            @map("bon_id")
  bon               Bon               @relation(fields: [bonId], references: [id], onDelete: Cascade)
  catalogItemId     String?           @map("catalog_item_id")
  // RESTRICT (et non le SET NULL par défaut d'une relation optionnelle) : un
  // article de catalogue déjà référencé sur un bon — signé ou non — ne doit
  // jamais pouvoir être supprimé physiquement en silence (la traçabilité
  // d'un bon déjà signé serait rompue sans avertissement). La désactivation
  // logique (`active = false`) reste le seul chemin de retrait du catalogue.
  catalogItem       EquipmentCatalog? @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  customLabel       String?           @map("custom_label")
  serialNumber      String?           @map("serial_number")
  inventoryNumber   String?           @map("inventory_number")
  notes             String?
  order             Int               @default(0)
  returnedAt        DateTime?         @map("returned_at")
  notReturned       Boolean           @default(false) @map("not_returned")
  notReturnedReason String?           @map("not_returned_reason")
  createdAt         DateTime          @default(now()) @map("created_at")

  @@index([bonId])
  @@index([catalogItemId])
  @@index([serialNumber])
  // Recherche d'un matériel par son numéro d'inventaire (page /materiel et
  // recherche globale) : même usage que le numéro de série, même index.
  @@index([inventoryNumber])
  // KPI (tableau de bord) : équipements rendus sur une période.
  @@index([returnedAt])
  @@map("bon_equipments")
}

enum SignatureType {
  mise_disposition
  restitution
  it_cachet
  pv_cloture
}

enum PdfSnapshotType {
  signature_it_mise_disposition
  signature_collab_mise_disposition
  signature_it_restitution
  signature_collab_restitution
  cloture_equipements_manquants
  avenant_equipement_retrouve
  // Documents des deux gestes « sans signature » (R-031) : jamais rangés sous
  // un type « signature du collaborateur », puisqu'il n'a pas signé.
  remise_sans_signature
  cloture_sans_signature
}

// Pourquoi un lien de signature a été invalidé avant d'être utilisé (R-038) :
// la page de signature dit le vrai motif au lieu de « un nouveau lien vous a
// été envoyé ». Null pour un lien encore valide, expiré naturellement, ou
// invalidé avant l'ajout de cette colonne (motif inconnu).
enum SignatureInvalidationReason {
  // Un nouveau lien pour le même document a été envoyé (renvoi, rappel,
  // nouveau document qui prend la suite).
  replaced
  // Le document se signe désormais au guichet (signature présentielle).
  in_person
  // Le bon a été modifié après l'envoi : un nouveau lien suivra.
  modified
  // Le marquage d'une restitution a été annulé ou corrigé : un nouveau lien suivra.
  return_corrected
  // Le bon a été annulé.
  cancelled
  // Le collaborateur a contesté le bon.
  contested
  // La remise a été constatée sans signature.
  handover_without_signature
  // Le bon a été clôturé sans signature.
  closed_without_signature
  // Le compte du collaborateur a été désactivé (départ).
  account_deactivated
}

model Signature {
  id                 String                       @id @default(uuid())
  bonId              String                       @map("bon_id")
  bon                Bon                          @relation(fields: [bonId], references: [id], onDelete: Cascade)
  type               SignatureType
  token              String                       @unique
  tokenExpiresAt     DateTime                     @map("token_expires_at")
  signed             Boolean                      @default(false)
  signatureImagePath String?                      @map("signature_image_path")
  signedAt           DateTime?                    @map("signed_at")
  signerEmail        String?                      @map("signer_email")
  signerIp           String?                      @map("signer_ip")
  signerUserAgent    String?                      @map("signer_user_agent")
  mentionLuApprouve  Boolean                      @default(false) @map("mention_lu_approuve")
  isInPerson         Boolean                      @default(false) @map("is_in_person")
  // Présentiel : signerEmail est le compte connecté sur l'appareil. Un compte
  // IT est un témoin (le titulaire signe devant lui) ; seul un AUTRE compte,
  // ni IT ni titulaire, signe pour le compte du collaborateur : mandataire.
  signedByProxy      Boolean                      @default(false) @map("signed_by_proxy")
  // Scellement probant : HMAC-SHA256 (clé serveur dérivée d'ENCRYPTION_KEY)
  // couvrant les champs probants de la signature → détecte toute altération
  // directe en base (email, horodatage…). sealedAt = moment du scellement.
  seal               String?                      @map("seal")
  sealedAt           DateTime?                    @map("sealed_at")
  // Horodatage RFC 3161 OPTIONNEL (config 'timestamp') : jeton signé d'une
  // autorité de temps de confiance sur le sceau. Absent si non configuré.
  tsToken            String?                      @map("ts_token")
  tsAuthority        String?                      @map("ts_authority")
  tsAt               DateTime?                    @map("ts_at")
  initiatedById      String?                      @map("initiated_by_id")
  initiatedBy        User?                        @relation("SignatureInitiatedBy", fields: [initiatedById], references: [id])
  // Type de document du cachet IT (mise_disposition | restitution) — écrit
  // par le flux de signature pour distinguer les cachets multi-documents.
  pdfType            String?                      @map("pdf_type")
  // Invalidation volontaire du lien (tokenExpiresAt ramené à l'epoch) : quand
  // et pourquoi. Voir SignatureInvalidationReason.
  invalidatedAt      DateTime?                    @map("invalidated_at")
  invalidatedReason  SignatureInvalidationReason? @map("invalidated_reason")
  createdAt          DateTime                     @default(now()) @map("created_at")
  // Documents PDF dont cette signature est la preuve (un par document signé).
  pdfSnapshots       PdfSnapshot[]

  @@index([bonId, type, signed])
  @@index([signed, tokenExpiresAt])
  // KPI (tableau de bord) : délais de signature sur une période.
  @@index([signedAt])
  @@index([createdAt])
  @@map("signatures")
}

// Pièces jointes d'un bon (photos d'état du matériel, justificatifs). Le binaire
// est chiffré sur disque (AES-256-GCM, comme les signatures) ; seules les
// métadonnées + le SHA-256 d'intégrité sont en base.
model Attachment {
  id              String   @id @default(uuid())
  bonId           String   @map("bon_id")
  bon             Bon      @relation(fields: [bonId], references: [id], onDelete: Cascade)
  // Contexte métier : mise_disposition | restitution | pv_cloture | general
  stage           String
  filename        String
  storedPath      String   @map("stored_path")
  mimeType        String   @map("mime_type")
  size            Int
  sha256          String
  label           String?
  uploadedById    String?  @map("uploaded_by_id")
  uploadedByEmail String?  @map("uploaded_by_email")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([bonId, createdAt])
  @@map("attachments")
}

// Archive probante APPEND-ONLY : une ligne par document de preuve généré,
// jamais écrasée. Elle double PdfSnapshot (lui aussi un document par
// signature, lu par la fiche et le portail) : aucune preuve co-signée — ex.
// une 1re restitution partielle — ne peut disparaître.
model ProofArchive {
  id        String   @id @default(uuid())
  bonId     String   @map("bon_id")
  bon       Bon      @relation(fields: [bonId], references: [id], onDelete: Cascade)
  type      String
  filename  String
  data      Bytes
  sha256    String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([bonId, createdAt])
  @@map("proof_archives")
}

model PdfSnapshot {
  id        String          @id @default(uuid())
  bonId     String          @map("bon_id")
  bon       Bon             @relation(fields: [bonId], references: [id], onDelete: Cascade)
  type      PdfSnapshotType
  data      Bytes
  filename  String
  // SHA-256 hex du document — chaîne de preuve (intégrité vérifiable a posteriori)
  sha256    String?
  // Signature dont ce document est la preuve : la signature du collaborateur
  // s'il a signé ce document, sinon la signature IT. Null pour un geste sans
  // signature et pour un document antérieur à cette colonne.
  signatureId String?       @map("signature_id")
  signature   Signature?    @relation(fields: [signatureId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now()) @map("created_at")

  // Historique complet : un document par signature et par contenu, jamais
  // écrasé. Plusieurs documents d'un même type (deux restitutions, remise
  // signée de nouveau après une modification, PV réémis) coexistent ; le plus
  // récent est la version en vigueur. L'unicité (bon, type, signature,
  // empreinte) n'écarte que le doublon exact : la génération est idempotente.
  @@unique([bonId, type, signatureId, sha256])
  @@index([bonId, type, createdAt])
  @@map("pdf_snapshots")
}

enum SmbExportStatus {
  pending
  success
  failed
}

model SmbExport {
  id            String          @id @default(uuid())
  bonId         String          @map("bon_id")
  bon           Bon             @relation(fields: [bonId], references: [id], onDelete: Cascade)
  filename      String
  status        SmbExportStatus @default(pending)
  errorMessage  String?         @map("error_message")
  retryCount    Int             @default(0) @map("retry_count")
  lastAttemptAt DateTime?       @map("last_attempt_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([status])
  @@index([bonId])
  @@map("smb_exports")
}

enum ContestationStatus {
  open
  in_review
  resolved
  rejected
}

// Issue d'une contestation tranchée (décision du 24/09) : deux issues
// seulement. `status` reste aligné (founded ↔ resolved, not_retained ↔
// rejected) pour les listes et indicateurs existants.
enum ContestationOutcome {
  // Fondée : correction toujours (nouveau bon envoyé, l'original remplacé).
  founded
  // Non retenue : rien ne change, le bon reprend son statut.
  not_retained
}

model Contestation {
  id                String               @id @default(uuid())
  bonId             String               @map("bon_id")
  bon               Bon                  @relation(fields: [bonId], references: [id])
  userId            String               @map("user_id")
  user              User                 @relation("ContestationUser", fields: [userId], references: [id])
  message           String
  status            ContestationStatus   @default(open)
  // Statut du bon au moment de la contestation, rétabli si elle n'est pas
  // retenue. Remplace la relecture du journal d'audit, purgeable (P2, R-007).
  previousBonStatus BonStatus?           @map("previous_bon_status")
  // Document contesté : remise, restitution ou PV de non-restitution (R-054).
  contestedDocument SignatureType?       @map("contested_document")
  // Issue, renseignée seulement quand la contestation est tranchée.
  outcome           ContestationOutcome?
  // « Pris en charge par » (R-055), distinct de « tranché par » (resolvedBy).
  reviewedById      String?              @map("reviewed_by_id")
  reviewedBy        User?                @relation("ContestationReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?            @map("reviewed_at")
  // « Tranché par » : renseigné seulement quand l'issue est décidée.
  resolvedById      String?              @map("resolved_by_id")
  resolvedBy        User?                @relation("ContestationResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt        DateTime?            @map("resolved_at")
  resolutionMessage String?              @map("resolution_message")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@index([bonId])
  // KPI (tableau de bord) : contestations ouvertes sur une période, délai de résolution.
  @@index([createdAt])
  @@index([status, updatedAt])
  @@map("contestations")
}

enum NotificationType {
  mise_dispo_request
  restitution_request
  pv_cloture_request
  reminder
  confirmation
  contestation_alert
  contestation_resolution
  cancellation
  mark_found
  // Email « bon clôturé sans signature » (geste « Clôturer sans signature »).
  unilateral_closure
  restitution_due_reminder
  // Email « remise constatée sans signature » (R-014), distinct de la clôture.
  handover_without_signature
  // Relance de l'IT : contestation non traitée sous 7 jours.
  contestation_overdue_alert
  // Alerte de l'IT : le collaborateur demande un nouveau lien (R-058).
  link_request_alert
}

enum NotificationStatus {
  sent
  failed
  bounced
  // Non envoyé par choix, pas par panne (collaborateur sans adresse :
  // présentiel uniquement, R-034) : exclu des « emails en échec ».
  skipped
}

model NotificationLog {
  id             String             @id @default(uuid())
  bonId          String             @map("bon_id")
  bon            Bon                @relation(fields: [bonId], references: [id])
  recipientEmail String             @map("recipient_email")
  type           NotificationType
  sentAt         DateTime           @default(now()) @map("sent_at")
  status         NotificationStatus
  errorMessage   String?            @map("error_message")
  reminderNumber Int?               @map("reminder_number")
  // Document concerné par une demande de signature ou un rappel : les rappels
  // se comptent PAR DOCUMENT (3 au plus), depuis Bon.awaitingSince (R-033).
  documentType   SignatureType?     @map("document_type")

  @@index([bonId, type])
  @@index([status, sentAt])
  // KPI (tableau de bord) : rappels envoyés par rang sur une période, emails en échec.
  @@index([type, sentAt])
  @@map("notification_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  bonId     String?  @map("bon_id")
  bon       Bon?     @relation(fields: [bonId], references: [id])
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  userEmail String?  @map("user_email")
  action    String
  details   Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([bonId, createdAt])
  @@index([userEmail, action, createdAt])
  // Verrou brute-force par IP (LOT C bug #2) : checkBruteForce() compte les
  // login_local_failed par ipAddress seul sur une fenêtre de 30 min — sans cet
  // index la requête dégénère en scan séquentiel de toute la table d'audit.
  @@index([ipAddress, action, createdAt])
  // KPI (tableau de bord) : compteurs d'audit (non-rendus, PV, annulations…) sur une période.
  @@index([action, createdAt])
  @@map("audit_logs")
}

// Persistent revocation list for refresh tokens: survives restarts so that
// logout and rotation-replay detection remain effective across redeploys.
model RevokedToken {
  tokenHash String   @id @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("revoked_tokens")
}

enum ScheduledJobStatus {
  success
  error
  skipped
}

// Suivi de la dernière exécution de chaque tâche planifiée (@Cron) — un seul
// enregistrement par tâche (clé "job"), réécrit à chaque exécution. Alimente
// GET /api/admin/status (lot A5, supervision). lastError ne contient jamais
// de secret ni de donnée personnelle : le message d'erreur seul, tronqué à
// 500 caractères par l'enregistreur applicatif (backend/src/monitoring).
model ScheduledJobRun {
  job            String              @id
  lastStartedAt  DateTime?           @map("last_started_at")
  lastFinishedAt DateTime?           @map("last_finished_at")
  lastStatus     ScheduledJobStatus? @map("last_status")
  lastError      String?             @map("last_error")
  lastDurationMs Int?                @map("last_duration_ms")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@map("scheduled_job_runs")
}
