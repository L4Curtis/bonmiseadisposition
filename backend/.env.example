# ─── Base de données ──────────────────────────────────────────────────────────
# Gérée automatiquement par docker-compose (ne pas modifier DATABASE_URL manuellement)
DATABASE_URL=postgresql://app:POSTGRES_PASSWORD@db:5432/bons_disposition

# ─── Secrets obligatoires ─────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
ENCRYPTION_KEY=changeme_must_be_32_chars_minimum_____
JWT_SECRET=changeme_must_be_32_chars_minimum_________

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
# URL publique de l'application (utilisée pour construire les liens de signature dans les emails)
FRONTEND_URL=http://localhost:5173
PORT=4000

# ─── Compte administrateur initial ────────────────────────────────────────────
# Si absent : un mot de passe aléatoire est généré et affiché dans les logs au 1er démarrage
DEFAULT_ADMIN_PASSWORD=

# ─── PostgreSQL (utilisé par docker-compose) ──────────────────────────────────
POSTGRES_PASSWORD=changeme
