# ─── Base de données ──────────────────────────────────────────────────────────
# Gérée automatiquement par docker-compose (ne pas modifier DATABASE_URL manuellement)
DATABASE_URL=postgresql://app:POSTGRES_PASSWORD@db:5432/bons_disposition

# ─── Secrets obligatoires ─────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
ENCRYPTION_KEY=changeme_must_be_32_chars_minimum_____
JWT_SECRET=changeme_must_be_32_chars_minimum_________

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
# URL publique de l'application (utilisée pour construire les liens de signature dans les emails)
FRONTEND_URL=http://localhost:5173
PORT=4000

# ─── Compte administrateur initial ────────────────────────────────────────────
# Si absent : un mot de passe aléatoire est généré et écrit dans data/initial-admin-password.txt
# (jamais dans les logs). Le fichier est supprimé automatiquement au premier changement
# de mot de passe réussi de admin@local (changement obligatoire à la première connexion).
DEFAULT_ADMIN_PASSWORD=

# ─── PostgreSQL (utilisé par docker-compose) ──────────────────────────────────
POSTGRES_PASSWORD=changeme

# ─── Configuration applicative — PAS via l'environnement ──────────────────────
# LDAP, Entra ID, SMTP, rappels, rétention, filiales... se configurent via
# l'interface web /admin/configuration après le premier lancement.
# En particulier, smtp.from (adresse d'expédition) et general.app_url (URL publique)
# sont OBLIGATOIRES dans l'admin : tant qu'ils ne sont pas renseignés, aucun email
# de signature ne part (erreur explicite dans l'historique des emails du bon).
