# ─── Variables d'environnement — Production ───────────────────────────────
# Copier ce fichier en .env et renseigner les valeurs avant le premier démarrage
# NE PAS committer le fichier .env dans git
#
# Usage :
#   cp .env.example .env
#   nano .env     # remplacer les valeurs CHANGER_*
#   docker compose -f docker-compose.prod.yml up -d

# ── Sécurité ────────────────────────────────────────────────────────────────

# Clé de chiffrement AES-256-GCM pour les signatures PNG et la config sensible en base
# 32 bytes = 64 caractères hexadécimaux
# IMPORTANT : ne jamais changer après le premier lancement (les données chiffrées seraient illisibles)
# Générer : openssl rand -hex 32
ENCRYPTION_KEY=CHANGER_CETTE_VALEUR_OPENSSL_RAND_HEX_32

# Secret JWT pour la signature des tokens d'authentification (access + refresh)
# Doit être différent de ENCRYPTION_KEY pour isoler les surfaces d'attaque
# Générer : openssl rand -hex 32
JWT_SECRET=CHANGER_CETTE_VALEUR_OPENSSL_RAND_HEX_32_JWT

# Mot de passe PostgreSQL (utilisateur "app", base "bons_disposition")
# Générer : openssl rand -base64 24
POSTGRES_PASSWORD=CHANGER_CETTE_VALEUR

# ── Application ─────────────────────────────────────────────────────────────

# URL publique HTTPS de l'application (sans slash final)
# Doit correspondre exactement au domaine configuré dans Nginx Proxy Manager
# Utilisé pour : CORS backend, redirects SSO Entra ID, liens dans les emails de signature
FRONTEND_URL=https://bons.groupelivio.local

# ── Port d'exposition frontend ───────────────────────────────────────────────

# Port exposé sur l'hôte pour Nginx Proxy Manager (défaut: 5147)
# NPM doit pointer sur http://<vm>:FRONTEND_PORT
# Optionnel — ne renseigner que si le port 5147 est déjà pris
# FRONTEND_PORT=5147

# ── Rappel — variables gérées automatiquement ────────────────────────────────
# Ces variables sont construites dans docker-compose.prod.yml, pas besoin de les renseigner :
#   DATABASE_URL  = postgresql://app:${POSTGRES_PASSWORD}@db:5432/bons_disposition
#   NODE_ENV      = production (hardcodé dans le compose)
#
# Toute la configuration applicative (LDAP, Entra ID, SMTP, rappels, filiales...)
# est administrable via l'interface web /admin/configuration après le premier lancement.
